# modifier
set $mod Mod4
set $modA Shift

# terminal
set $term kitty

# launcher
set $menu wofi --show drun


### Style ###

default_border pixel 2
default_floating_border pixel 2

gaps inner 8
gaps outer 4

# disable titlebar
for_window [class="^.*"] border pixel 2


### Keybinds ###

bindsym $mod+C kill
bindsym $mod+Q exec $term
bindsym $mod+D exec $menu
bindsym $mod+R reload

# move focus
bindsym $mod+Left 	focus left
bindsym $mod+Right 	focus right
bindsym $mod+Up 		focus up
bindsym $mod+Down 	focus down

# move window
bindsym $mod+Ctrl+Left 	move left
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+Up 		move up
bindsym $mod+Ctrl+Down 	move down


### Layout ###

# split
bindsym $mod+b splith
bindsym $mod+n splitv

# fullscreen
bindsym $mod+f fullscreen toggle

# floating
bindsym $mod+v floating toggle

# focus parent
bindsym $mod+a focus parent

# layout modes
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split


### Workspaces ###

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+$modA+1 move container to workspace number 1
bindsym $mod+$modA+2 move container to workspace number 2
bindsym $mod+$modA+3 move container to workspace number 3
bindsym $mod+$modA+4 move container to workspace number 4
bindsym $mod+$modA+5 move container to workspace number 5
bindsym $mod+$modA+6 move container to workspace number 6
bindsym $mod+$modA+7 move container to workspace number 7
bindsym $mod+$modA+8 move container to workspace number 8
bindsym $mod+$modA+9 move container to workspace number 9
bindsym $mod+$modA+0 move container to workspace number 10


### Bar ###

bar {
	swaybar_command waybar
}


### Wallpaper ###

#output * bg ~/Pictures/wallpaper.png fill


### Input ###

input type:keyboard {
	xkb_layout de
	xkb_variant nodeadkeys
	xkb_model ""
	xkb_options "caps:escape,kpdl:dot,lv3:lalt_switch,lv3:ralt_alt"
	xkb_rules ""

	xkb_numlock enabled
}

input type:touchpad {
	natural_scroll disabled
}

input type:pointer {
	pointer_accel -0.2
}

