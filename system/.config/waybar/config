// -*- mode: jsonc -*-
{
    "output": "eDP-1",
    "layer": "bottom", // Waybar at (bottom|top) layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "custom/bt",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "power-profiles-daemon",
        "custom/clock",
        "custom/noti",
        "tray",
        "custom/power"
    ],

    // Modules configuration
    "sway/workspaces": {
        "all-outputs": true
    },
    "sway/window": {
        "format": " {title} ",
        "separate-outputs": false,
        "icon": true,
        "icon-size": 18
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "cpu": {
        "format": "{usage}% {icon}",
				"format-icons": "",
        "tooltip": false
    },
    "memory": {
        "format": "{}% ",
        "on-click": "kitty -e btop"
    },
    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
				"tooltip": false
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
				"format-icons": "",
				"tooltip": false
    },
    "battery": {
        "states": {
						"full": 100,
            "good": 90,
            "warning": 30,
            "critical": 15
        },
				"smooth-power": true,
        "smooth-power-time-constant": 260.0, // default is 260.0
				"format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{signalStrength}% ", //{essid}
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: '{essid}'" //"{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "<span color='#f38ba8'></span> {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "<span color='#f38ba8'></span>",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol -t 3"
    },
    "custom/power": {
        "format" : "",
				"tooltip": false,
				"menu": "on-click",
				"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
				"menu-actions": {
						"shutdown": "shutdown now",
						"reboot": "reboot",
						"suspend": "systemctl suspend",
						"hibernate": "systemctl hibernate"
				}
    },
    "custom/clock": {
        "exec": "date +'%d. %b %H:%M'",
        "interval": 60,
				"tooltip": false
    },
    "custom/noti": {
        "format": "",
        "tooltip-format": "Notifications",
        "on-click": "swaync-client --toggle-panel"
    },
    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "<span color='#f38ba8'>{player_icon} {artist} - {title}</span>", //<i> </i>
        "max-length": 50,
        "player-icons": {
            "spotify": "<span color='#a6e3a1'> </span>",
            "vlc": "<span color='#fab387'>󰕼 </span>",
            "firefox": "<span color='#f38ba8'> </span>",
            "default": "▶",
            "mpv": ""
        },
        "status-icons": {
            "paused": "⏸"
        }
    },
    "custom/bt": {
        "format": " {icon} ",
				"format-icons": "",
        "on-click": "blueman-manager",
				"tooltip": false
    }
}
